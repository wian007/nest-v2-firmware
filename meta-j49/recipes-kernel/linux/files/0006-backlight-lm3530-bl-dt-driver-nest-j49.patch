--- a/drivers/video/backlight/Kconfig	2026-10-31 16:34:32.213817905 +0100
+++ b/drivers/video/backlight/Kconfig	2026-10-31 16:34:32.232958262 +0100
@@ -452,6 +452,14 @@
 	help
 	  If you have a Rohm BD6107 say Y to enable the backlight driver.
 
+config BACKLIGHT_LM3530_BL
+	tristate "TI LM3530 backlight driver (I2C brightness mode, device tree)"
