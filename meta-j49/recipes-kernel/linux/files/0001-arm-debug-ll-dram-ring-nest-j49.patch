+/*
+ * NEST-FL early-boot breadcrumbs: drop one byte into the header of the
+ * DEBUG_LL DRAM ring (arch/arm/include/debug/ramring.S, 0x83e80000) at fixed
+ * points of the decompressor, so a hang before decompress_kernel() can still
+ * be located from the previous OS via /dev/mem. Writes +0x10.. and a duplicate
+ * at +0x20.. (same cache line), cleaned to DRAM with DCCMVAC. Only r3/ip are
+ * touched; the stacked variant saves them (sp is valid from restart: on).
+ */
+		.macro	ringmark_nostack, ch, off
+		mov	ip, #0x83000000
+		orr	ip, ip, #0x00e80000
+		mov	r3, #\ch
+		strb	r3, [ip, #0x10 + \off]
+		strb	r3, [ip, #0x20 + \off]
+		mcr	p15, 0, ip, c7, c10, 1
+		dsb
+		.endm
+
+		.macro	ringmark, ch, off
+		push	{r0, r3, ip}
+		ringmark_nostack \ch, \off
+		pop	{r0, r3, ip}
+		.endm
+
 		.macro	kputc,val
 		mov	r0, \val
 		bl	putc
@@ -228,6 +253,7 @@
 #endif
 		mov	r7, r1			@ save architecture ID
 		mov	r8, r2			@ save atags pointer
+		ringmark_nostack 0x41, 0	@ NEST-FL "A": zImage entered
 
 #ifndef CONFIG_CPU_V7M
 		/*
@@ -327,6 +353,9 @@
 		cmpcc	r4, r0
 		orrcc	r4, r4, #1		@ remember we skipped cache_on
 		blcs	cache_on
+		ringmark_nostack 0x42, 1	@ NEST-FL "B": past cache_on (sp NOT valid yet: set at restart:; r3/ip dead here)
+		nop
+		nop				@ keep layout identical to the push/pop variant (adr range)
 
 restart:	adr	r0, LC1
 		ldr	sp, [r0]
@@ -445,6 +474,7 @@
 		add	sp, sp, r5
 dtb_check_done:
 #endif
+		ringmark 0x43, 2		@ NEST-FL "C": appended DTB/ATAG compat done
 
 /*
  * Check to see if we will overwrite ourselves.
@@ -627,6 +657,7 @@
