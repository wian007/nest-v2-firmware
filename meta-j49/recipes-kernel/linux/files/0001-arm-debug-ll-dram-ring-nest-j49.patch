--- /dev/null
+++ b/arch/arm/include/debug/ramring.S
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DEBUG_LL backend that writes into a DRAM ring buffer instead of a UART.
+ *
+ * For boards with no debug UART wired (Nest J49 "diamond"): the ring is read
+ * back from the previous OS via /dev/mem after the watchdog warm reset, so the
+ * decompressor banner, head.S error paths and earlyprintk all become visible
+ * hands-free.
+ *
+ * Layout at RAMRING_PHYS (64 KiB; reserve it in DT WITHOUT no-map so the
+ * kernel's linear mapping still covers it):
+ *   +0x0000  u32 idx     write index 0..0x7eff (duplicated at +0x4)
+ *   +0x0100  copy A      text, indexed by idx
+ *   +0x8100  copy B      identical second copy
+ * Two copies because this DRAM loses ~1% of set bits across the OMAP3 warm
+ * reset (decay is 1->0 only); OR-merging the copies on readback recovers the
+ * text. Every store is followed by DCCMVAC so the byte reaches DRAM whether
+ * the current mapping is cacheable (decompressor flat map, post-paging_init
+ * linear map) or device (head.S maps the "debug UART" section as such).
+ *
+ * ip is used as scratch: it is free at every call site (printascii/printch in
+ * arch/arm/kernel/debug.S and putc in arch/arm/boot/compressed/debug.S).
+ */
+#define RAMRING_PHYS	0x83e80000
+#define RAMRING_VIRT	0xf7e80000	/* fixed vmalloc-space page: head.S maps the 1 MB
+					 * section early; after paging_init it is re-mapped as
+					 * a device page by debug_ll_io_init() from omap3_map_io() */
+
+		.macro	addruart, rp, rv, tmp
+		ldr	\rp, =RAMRING_PHYS
+		ldr	\rv, =RAMRING_VIRT
+		.endm
+
+		.macro	senduart, rd, rx
+		ldr	ip, [\rx]			@ idx
+		add	ip, ip, #0x100
+		strb	\rd, [\rx, ip]			@ copy A
+		add	ip, \rx, ip
+		mcr	p15, 0, ip, c7, c10, 1		@ DCCMVAC: copy A line -> DRAM
+		add	ip, ip, #0x8000
+		strb	\rd, [ip]			@ copy B
+		mcr	p15, 0, ip, c7, c10, 1		@ DCCMVAC: copy B line -> DRAM
+		sub	ip, ip, \rx
+		sub	ip, ip, #0x8000
+		sub	ip, ip, #0xff			@ idx + 1
+		cmp	ip, #0x7f00
+		movge	ip, #0				@ wrap
+		str	ip, [\rx]
+		str	ip, [\rx, #4]
+		mcr	p15, 0, \rx, c7, c10, 1		@ DCCMVAC: idx line -> DRAM
+		dsb
+		.endm
+
+		.macro	waituartcts, rd, rx
+		.endm
+
+		.macro	waituarttxrdy, rd, rx
+		.endm
+
+		.macro	busyuart, rd, rx
+		.endm
