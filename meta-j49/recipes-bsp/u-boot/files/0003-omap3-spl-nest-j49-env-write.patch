+static void nest_nand_wait_ready(void)
+{
+	int i;
+	writeb(0x70, &gpmc_cfg->cs[0].nand_cmd);		/* READ STATUS */
+	for (i = 0; i < 4000000; i++)
+		if (readb(&gpmc_cfg->cs[0].nand_dat) & 0x40)	/* bit6 = ready */
+			break;
+}
+
+/*
+ * Program the GPMC BCH engine to compute ONE BCH4 syndrome over the next
+ * 512-byte sector streamed through the NAND data port. Mirrors
+ * omap_enable_hwecc_bch() (write/compute path: wrap mode 6 = main area only,
+ * ecc_size0=0, ecc_size1=32) but with bch_type=0 (BCH4) and dev_width=1 (x16).
+ * The engine computes as bytes flow through gpmc_cfg->cs[0].nand_dat during
+ * the page-program data phase, so compute and NAND write are a single pass.
+ */
+static void nest_bch4_start(void)
+{
+	u32 val;
+
+	writel(NEST_ECCRESULTREG1, &gpmc_cfg->ecc_control);
+	val = (0x20 << NEST_ECCSIZE1_SHIFT) | (0x0 << NEST_ECCSIZE0_SHIFT);
+	writel(val, &gpmc_cfg->ecc_size_config);
+	val = (1u << 16)	/* enable BCH */
+	    | (0u << 12)	/* bch_type = 0 -> BCH4 (4-bit) */
+	    | (6u <<  8)	/* wrap mode 6 (main area only) */
+	    | (1u <<  7)	/* dev_width = 1 -> x16 */
+	    | (0u <<  4)	/* (nsectors - 1) = 0 -> 1 sector */
+	    | (0u <<  1)	/* ECC on CS0 */
+	    | (1u);		/* enable ECC */
+	writel(val, &gpmc_cfg->ecc_config);
+	writel(NEST_ECCCLEAR | NEST_ECCRESULTREG1, &gpmc_cfg->ecc_control);
+}
+
+/*
+ * Read the 52-bit BCH4 remainder for sector 0 out of GPMC_BCH_RESULT1:0 and
+ * pack it MSB-first into 7 bytes -- the STOCK raw layout, with NO erased-page
+ * polynomial fold (OMAP_ECC_BCH4_CODE_HW, not _DETECTION_SW). Packing is bit-
+ * identical to mainline drivers/mtd/nand/raw/omap2.c _omap_calculate_ecc()
+ * BCH4 branch: result1[19:0] = remainder[51:32], result0[31:0] = [31:0];
+ * bytes are taken most-significant-first and the final nibble lands in the
+ * high nibble of byte 6.
+ */
+static void nest_bch4_read(unsigned char *ecc)
+{
+	u32 hi = readl(&gpmc_cfg->bch_result_0_3[0].bch_result_x[1]); /* RESULT1 */
+	u32 lo = readl(&gpmc_cfg->bch_result_0_3[0].bch_result_x[0]); /* RESULT0 */
+
+	ecc[0] = (hi >> 12) & 0xff;
+	ecc[1] = (hi >>  4) & 0xff;
+	ecc[2] = ((hi & 0xf) << 4) | ((lo >> 28) & 0xf);
+	ecc[3] = (lo >> 20) & 0xff;
+	ecc[4] = (lo >> 12) & 0xff;
+	ecc[5] = (lo >>  4) & 0xff;
+	ecc[6] = (lo & 0xf)  << 4;
+}
+
+/*
+ * Program one 2048+64 page: PROGRAM-PAGE (0x80), 2 column + 3 row address
+ * cycles (col = 0), stream 4 x 512 data bytes as 16-bit words while the BCH
+ * engine computes each sector's 7 ECC bytes, then stream the 64 OOB bytes
+ * (0..35 = 0xFF, 36..63 = the 28 ECC bytes), PROGRAM confirm (0x10), wait.
+ */
+static void nest_nand_program_page(u32 page, const unsigned char *data)
+{
+	unsigned char ecc[28];
+	int s, k;
+
+	writeb(0x80, &gpmc_cfg->cs[0].nand_cmd);		/* PROGRAM PAGE */
+	writeb(0x00, &gpmc_cfg->cs[0].nand_adr);		/* col[7:0]  = 0 */
+	writeb(0x00, &gpmc_cfg->cs[0].nand_adr);		/* col[10:8] = 0 */
+	writeb(page & 0xff, &gpmc_cfg->cs[0].nand_adr);		/* row[7:0]  */
+	writeb((page >>  8) & 0xff, &gpmc_cfg->cs[0].nand_adr);	/* row[15:8] */
+	writeb((page >> 16) & 0xff, &gpmc_cfg->cs[0].nand_adr);	/* row[17:16]*/
+
+	for (s = 0; s < 4; s++) {
+		const unsigned char *p = data + s * 512;
+
+		nest_bch4_start();
+		for (k = 0; k < 512; k += 2)		/* 256 x16 words */
+			writew(p[k] | (p[k + 1] << 8),
+			       &gpmc_cfg->cs[0].nand_dat);
+		nest_bch4_read(&ecc[s * 7]);
+	}
+
+	for (k = 0; k < 64; k += 2) {			/* 32 x16 OOB words */
+		unsigned char b0 = (k     >= 36) ? ecc[k     - 36] : 0xff;
+		unsigned char b1 = (k + 1 >= 36) ? ecc[k + 1 - 36] : 0xff;
+
+		writew(b0 | (b1 << 8), &gpmc_cfg->cs[0].nand_dat);
+	}
+
+	writeb(0x10, &gpmc_cfg->cs[0].nand_cmd);		/* PROGRAM confirm */
+	nest_nand_wait_ready();
+}
+
+static void nest_env_write_and_reset(void)
+{
+	unsigned char *buf = (unsigned char *)NEST_ENV_DRAM_BUF;
+	u32 blk, p, i;
+
+	gpmc_init();	/* configure GPMC CS0 for NAND (x16) */
+
+	/* RESET NAND (0xFF): the ROM's boot reads may leave it mid-operation. */
+	writeb(0xff, &gpmc_cfg->cs[0].nand_cmd);
+	nest_nand_wait_ready();
+
+	/* Build the 0x20000 env image in DRAM: 1862-byte blob + 0x00 fill. */
+	for (i = 0; i < sizeof(nest_env_blob); i++)
+		buf[i] = nest_env_blob[i];
+	for (i = sizeof(nest_env_blob); i < 0x20000; i++)
+		buf[i] = 0x00;
+
+	/* ERASE env0+env1 (blocks 26..31) -- same bounded range as the erase
+	 * recovery. env1 is left erased so stock's redundant-env logic picks
+	 * env0 (the only block with a valid CRC). */
+	for (blk = 26; blk <= 31; blk++) {
+		u32 page = blk * 64;
+
+		writeb(0x60, &gpmc_cfg->cs[0].nand_cmd);		/* ERASE setup */
+		writeb(page & 0xff, &gpmc_cfg->cs[0].nand_adr);
+		writeb((page >>  8) & 0xff, &gpmc_cfg->cs[0].nand_adr);
+		writeb((page >> 16) & 0xff, &gpmc_cfg->cs[0].nand_adr);
+		writeb(0xd0, &gpmc_cfg->cs[0].nand_cmd);		/* ERASE confirm */
+		nest_nand_wait_ready();
+	}
+
+	/* WRITE the image into env0 (block 26 = abs 0x340000), 64 pages. */
+	for (p = 0; p < 64; p++)
+		nest_nand_program_page(26 * 64 + p, buf + p * 2048);
+
+	writel(readl((void *)0x48307250) | 0x2, (void *)0x48307250); /* PRM warm reset */
+	for (;;)
+		;
+}
