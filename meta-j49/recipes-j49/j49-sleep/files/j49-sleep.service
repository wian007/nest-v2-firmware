[Unit]
Description=J49 sleep manager: suspends the head unit when nothing needs it (j49-sleep)
# Sleeps unless /var/lib/j49/sleep has enabled=off ("j49-sleep off", the web page, MQTT).
After=bpd.service j49-screen.service network.target

[Service]
ExecStart=/usr/bin/j49-sleep run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
