#!/bin/sh
# j49-release: what is running. /etc/j49-release says which commit the root filesystem was built
# from; the rest is read live, because the kernel (boot0) and the active root slot are installed
# separately from the root filesystem.
cat /etc/j49-release 2>/dev/null || echo "commit=unknown (no /etc/j49-release)"
# the slot is what is mounted on /: nandio (the first program the kernel starts) chooses it, the
# kernel command line is only its default
r=$(awk '$2 == "/" && $1 ~ /mtdblock/ { d = $1 } END { print d }' /proc/mounts)
a=$(sed -n 's/^mtd\([0-9]*\):.*"root0"$/\1/p' /proc/mtd)
b=$(sed -n 's/^mtd\([0-9]*\):.*"root1"$/\1/p' /proc/mtd)
case "$r" in
    /dev/mtdblock$a) s=a ;;
    /dev/mtdblock$b) s=b ;;
    *) s=unknown ;;
esac
echo "slot=$s"
echo "root=$r"
echo "kernel=$(uname -r) $(uname -v)"
# what restarted the board last time, as far as the watchdog driver knows (needs WATCHDOG_SYSFS)
b=$(cat /sys/class/watchdog/watchdog0/bootstatus 2>/dev/null)
case "$b" in
    "") ;;
    32) echo "last_reset=watchdog" ;;
    0) echo "last_reset=not the watchdog (power, the backplate, a restart that was asked for)" ;;
    *) echo "last_reset=bootstatus $b" ;;
esac
