# After the default dark theme of Home Assistant: near-black background, light grey text, blue
# accent and the orange Home Assistant uses for "heating".
name=HOME ASSISTANT
bg=111111
surface=1c1c1c
surface2=282828
line=383838
dim=9b9b9b
text=e1e1e1
strong=ffffff
accent=03a9f4
heat=ff8100
ok=43a047
error=db4437
info=03a9f4
# Roboto, the font of Home Assistant (a smooth font; falls back to the built-in one where
# the file is not installed)
font=roboto
digits=smooth
web_font=Roboto, "Noto Sans", system-ui, sans-serif
dial=18
