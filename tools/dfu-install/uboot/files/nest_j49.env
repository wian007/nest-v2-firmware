# SPDX-License-Identifier: GPL-2.0-or-later
# nest_j49.env -- the ENTIRE default environment of the installer U-Boot.
# The flash-env trick (CONFIG_USE_DEFAULT_ENV_FILE) means the env on NAND
# (stock format, unreadable with our ECC) is simply never used: every boot
# falls back to this file. That is deliberate -- the boot chain is fully
# defined by the binary we flash in session 1.
#
# Boot policy (headless, no abort):
#   nandboot      read the kernel uImage from boot0 (5 MB window) and bootm;
#                 a blank/stock boot0 fails the header check and falls
#                 through to usbinstall
#   usbinstall    one dfu 0 window with BOTH alts (RAM + boot0), then try
#                 to bootz whatever the host put at 0x80A00000; if nothing
#                 was downloaded there (session 3 flashed boot0 instead),
#                 reset and go around -- nandboot then succeeds.
# Every failed kernel boot (bootm error) also lands in usbinstall: the
# device is its own recovery mode.

bootdelay=0
# BOOT POLICY (stage 3 done): our kernel in boot0 first, the DFU window only as fallback:
#   nandboot || usbinstall.  console output goes to nulldev -- there is no UART, and printf
#   without a stdout device resets the board (found 2026-11-22).
# RAM FLAGS at 0x83e00000 (written with `dfu-util -a ring -D` from a DFU window, or by Linux
# via /dev/mem before a watchdog reset); both are ONE-SHOT (cleared before use):
#   0xac0ac0ac  debug console on /dev/ttyACM0 (USB CDC-ACM) instead of booting
#   0xdf00df00  stay in the DFU window instead of booting boot0 (install / update)
# A flag that survived a power cycle once made every boot enter the console, hence one-shot.
bootcmd=if itest.l *0x83e00000 -eq 0xac0ac0ac; then mw.l 0x83e00000 0; setenv stdin usbacm; setenv stdout usbacm; setenv stderr usbacm; elif itest.l *0x83e00000 -eq 0xdf00df00; then mw.l 0x83e00000 0; setenv stdin nulldev; setenv stdout nulldev; setenv stderr nulldev; run usbinstall; else setenv stdin nulldev; setenv stdout nulldev; setenv stderr nulldev; run nandboot || run usbinstall; fi

# safety net: OMAP WDT2 for ~120 s right before the kernel starts. A kernel that hangs before its
# watchdog driver takes over resets the board back into U-Boot (DRAM, incl. the debug ring, survives).
# WDT2's fck/ick (CM_FCLKEN_WKUP/CM_ICLKEN_WKUP bit 5) are OFF after a stock-kernel reboot and a register
# write then hangs the bus (found 2026-11-23: no Linux and no USB after every rescue flash); switch them on first.
wdtarm=setexpr.l wdt_v *0x48004c00 '|' 0x20; mw.l 0x48004c00 ${wdt_v}; setexpr.l wdt_v *0x48004c10 '|' 0x20; mw.l 0x48004c10 ${wdt_v}; mw.l 0x4831402c 0xffc40000; mw.l 0x48314028 0xffc40000; mw.l 0x48314048 0xbbbb; mw.l 0x48314048 0x4444
# nestusb: prime the USB gadget/PHY the way the console path does -- without it the kernel gets
# "musb VBUS_ERROR in b_idle (<SessEnd)" after a plain cold boot and g_serial never enumerates
# progress markers in the ring window (0x83ef0f00): 0xb1 start, b2 nand read ok, b3 usb primed, b4 wdt armed
# -- read with `dfu-util -a ring -U` after a hang to see the last step that completed
# the DEBUG_LL ring (0x83e80000, 4 KB) is cleared first so a breadcrumb found afterwards really comes from the kernel
nandboot=mw.l 0x83ef0f00 0xb1; mw.l 0x83e80000 0 0x400; nand read 0x80A00000 0x400000 0x500000 && mw.l 0x83ef0f00 0xb2 && nestusb 1500 && mw.l 0x83ef0f00 0xb3 && run wdtarm && mw.l 0x83ef0f00 0xb4 && bootm 0x80A00000
usbinstall=dfu 0; if itest.l *0x83e00000 -eq 0xac0ac0ac; then reset; fi; bootz 0x80A00000 || reset

# kernel bootargs (ATAG). NOTE the built-in CONFIG_CMDLINE is appended AFTER the ATAG/DT part and
# the last root= wins, so the root slot is decided by the kernel build (installer/build.sh sets
# root=/dev/mtdblock6 = root0 in the production uImage), not by this line.
bootargs=console=ttyS0,115200 console=tty0 root=/dev/mtdblock6 rootfstype=jffs2 rootwait

# one dfu window, three interfaces:
#   installer -> RAM 8 MB at 0x80A00000 (stage 2: the small installer kernel)
#   rootfs    -> RAM 22 MB at 0x82000000 (stage 2: the raw jffs2; the init
#                streams it from /dev/mem into /dev/mtd6 -- 22 MB is nearly
#                incompressible, so it cannot ride inside the kernel)
#   boot0     -> raw NAND 5 MB at 0x400000 (stage 3: the kernel uImage,
#                written by nand_write_skip_bad with this U-Boot's ECC)
#   ring      -> RAM 1 MB at 0x83e00000 (read-only debug: kernel ramoops +
#                DEBUG_LL ring, `dfu-util -a ring -U`; survives a warm reset)
# The rootfs window ends at 0x83510000, below U-Boot's relocation target.
dfu_alt_info=ram 0=installer ram 0x80A00000 0x800000&ram 0=rootfs ram 0x82000000 0x01510000&nand 0=boot0 raw 0x400000 0x500000&ram 0=ring ram 0x83e00000 0x00100000

# unused but handy over the UART1 console (nest #)
autoload=no
