// SPDX-License-Identifier: GPL-2.0-only
/*
 * Nest Learning Thermostat 2nd gen ("J49", board "diamond") -- the DFU
 * installer's U-Boot. RAM-booted by the STOCK x-loader from spl0: linked
 * at 0x80100000 (CONFIG_TEXT_BASE) and wrapped exactly like the stock
 * uImage there (mkimage -T standalone -O u-boot -a/-e 0x80100000), so
 * stock x-loader loads and runs it unchanged.
 *
 * Derived from omap3-beagle.dts (the same TARGET), with the board bits
 * from meta-j49's kernel omap3-nest-j49.dts: 64 MB RAM, UART1 console
 * (the physical W7/V7 test points), TWL4030 on I2C1, MUSB OTG. UART1 and
 * I2C1 pads are already muxed by the stock x-loader; the pinctrl nodes
 * pin them anyway. No display, no mmc, no leds: this is a bootloader.
 */
/dts-v1/;

#include "omap34xx.dtsi"

/ {
	model = "Nest Learning Thermostat 2nd Gen (J49)";
	compatible = "nest,j49", "ti,omap3";

	aliases {
		i2c0 = &i2c1;
		serial0 = &uart1;
	};

	cpus {
		cpu@0 {
			cpu0-supply = <&vcc>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x04000000>; /* 64 MB */
	};
};

&omap3_pmx_core {
	uart1_pins: pinmux_uart1_pins {
		pinctrl-single,pins = <
			/* dedicated pads, same values as the kernel hog */
			OMAP3_CORE1_IOPAD(0x214c, PIN_OUTPUT | MUX_MODE0)	/* uart1_tx, W7 */
			OMAP3_CORE1_IOPAD(0x2152, PIN_INPUT_PULLUP | MUX_MODE0)	/* uart1_rx, V7 */
		>;
	};
};

&uart1 {
	status = "disabled"; /* console off: with it enabled serial_init aborts and the board resets (2026-11-22); UART pads not reachable anyway */
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
};

/* one serial node: the console is UART1 by construction */
&uart2 { status = "disabled"; };
&uart3 { status = "disabled"; };

&i2c1 {
	/* 400 kHz, not the 2.6 MHz HS mode beagle uses: on this board the
	 * TWL4030 NACKs after HS-mode retransfers (kernel DTS, 2026-10-27) */
	clock-frequency = <400000>;

	twl: twl@48 {
		reg = <0x48>;
		interrupts = <7>; /* SYS_NIRQ cascaded to intc */
		interrupt-parent = <&intc>;
	};
};

/* the TWL4030 child devices (regulators, usb2_phy for MUSB) need the twl
 * label defined above, exactly like beagle.dts includes them */
#include "twl4030.dtsi"
#include "twl4030_omap3.dtsi"

&i2c2 { status = "disabled"; };
&i2c3 { status = "disabled"; };

&mmc1 { status = "disabled"; };
&mmc2 { status = "disabled"; };
&mmc3 { status = "disabled"; };

&usb_otg_hs {
	/* OTG; a normal USB cable to a host has floating ID = peripheral */
	interface-type = <0>;
	usb-phy = <&usb2_phy>;
	phys = <&usb2_phy>;
	phy-names = "usb2-phy";
	mode = <3>;
	power = <50>;
};

/*
 * NAND on GPMC CS0 (Micron MT29F2G16ABBEAH4, x16): the driver scans the
 * CS configuration the stock x-loader left and takes it over
 * (gpmc_nand_init), so no timings here. Partition offsets live in the
 * default env (nest_j49.env) as raw addresses -- same map as
 * docs/flash-layout.md. Written AND read by this U-Boot only, with its
 * own BCH8-SW ECC; nothing crosses ECC formats except spl0/spl1, which
 * the flashstub writes in stock BCH4 for the stock x-loader.
 */
&gpmc {
	status = "okay";
	ranges = <0 0 0x30000000 0x1000000>; /* CS0 window, 16 MB */

	nand@0,0 {
		compatible = "ti,omap2-nand";
		reg = <0 0 4>;
	};
};
