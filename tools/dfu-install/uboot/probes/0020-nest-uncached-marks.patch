diff -uNr a/include/nest_mark.h b/include/nest_mark.h
--- a/include/nest_mark.h	1970-01-01 01:00:00.000000000 +0100
+++ b/include/nest_mark.h	2026-11-22 21:41:25.625743767 +0100
@@ -0,0 +1,6 @@
+#ifndef NEST_MARK_H
+#define NEST_MARK_H
+/* marks live in 0x83e00000..0x83ffffff, made uncached by do_bootz */
+#define NEST_W(a, v) do { *(volatile unsigned int *)(a) = (unsigned int)(v); } while (0)
+#define NEST_M(n) NEST_W(0x83ef0100 + 4 * (n), 0x6d000000 | (n))
+#endif
