# probe8: dfu 0 with the three alts, '&' WITHOUT spaces (the parser reads the
# token before the first space as the interface, so " &" broke entity 2).
bootdelay=0
bootcmd=dfu 0
dfu_alt_info=ram 0=installer ram 0x80A00000 0x800000&ram 0=rootfs ram 0x82000000 0x01510000&nand 0=boot0 raw 0x400000 0x500000
autoload=no
