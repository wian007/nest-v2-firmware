#!/bin/sh
# Nest J49 DFU installer init (stage 2): write root0 (the A-slot rootfs) and
# show the steel installer screen on the round panel, then reboot.
#
# Boot context: RAM-booted by our U-Boot via dfu-util (bootz). Kernel cmdline
# comes from the U-Boot bootargs (console=ttyS0 console=tty0 ...); /init runs
# from the initramfs, so root= is never mounted here -- we write it.
#
# How the rootfs reaches us: the ~22 MB jffs2 is nearly incompressible and
# does NOT fit inside this kernel's initramfs on a 64 MB board. Stage 2
# downloads it as a SECOND DFU alt into DRAM at 0x82000000; nest-mtdflash
# streams it straight from /dev/mem into /dev/mtd6 (kernel-side ECC and
# bad-block handling), so no tmpfs copy of the image is ever made. The
# length is baked in at build time (@ROOT0_IMG_LEN@).
#
# The panel: fbcon owns /dev/fb0 from console=tty0; we unbind it so
# j49-screen can own the display. j49-screen --screen install polls
# /run/install.state (PHASE/PCT/TARGET/INFO/CODE); nest-mtdflash updates it
# with exact block/byte progress.
/bin/busybox mount -t proc none /proc 2>/dev/null
/bin/busybox mount -t sysfs none /sys 2>/dev/null
/bin/busybox mount -t devtmpfs none /dev 2>/dev/null
/bin/busybox --install -s /bin 2>/dev/null
mkdir -p /run
export PATH=/bin:/sbin:/usr/sbin
STATE=/run/install.state

# reboot through the OMAP watchdog (clean PRM reset that brings U-Boot back up);
# `reboot -f` (kernel restart) leaves the board dead until a hard reset (ring).
wdtreset() {
    sync
    echo "NEST-INSTALL: reset via watchdog in ~60 s" > /dev/kmsg 2>/dev/null
    exec 3> /dev/watchdog 2>/dev/null
    sleep 300
    reboot -f
}

puts() { printf 'PHASE=%s\nPCT=%s\nTARGET=%s\nINFO=%s\nCODE=%s\n' "$1" "$2" "$3" "$4" "$5" > "$STATE"; }
puts wait 0 ROOT0 "" ""

echo "NEST-INSTALL: stage 2 init, $(uname -srm)" > /dev/kmsg 2>/dev/null

# panel device: omapdrm binds at ~1-2 s; fbcon off so nothing paints over us
i=0
while [ ! -c /dev/fb0 ] && [ $i -lt 400 ]; do i=$((i + 1)); sleep 0.1; done
if [ -c /dev/fb0 ]; then
    echo 0 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null
    j49-screen --screen install --fps 15 >/dev/null 2>&1 &
else
    echo "NEST-INSTALL: no /dev/fb0 -- flashing blind" > /dev/kmsg 2>/dev/null
fi

echo "NEST-INSTALL: root0 = /dev/mtd6, jffs2 staging at 0x82000000" > /dev/kmsg 2>/dev/null

# 1. erase root0 block by block, exact progress
nest-mtdflash /dev/mtd6 "$STATE" --erase 2> /run/mf.err; RC=$?
while read -r l; do echo "NEST-DBG mtdflash: $l" > /dev/kmsg; done < /run/mf.err
if [ $RC -ne 0 ]; then
    puts error 0 ROOT0 "" "E2 ERASE"
    echo "NEST-INSTALL: erase failed" > /dev/kmsg 2>/dev/null
    wdtreset
fi

# 2. stream the staging image from DRAM; kernel-side ECC via mtd_write/nand_write
nest-mtdflash /dev/mtd6 "$STATE" --from-mem 0x82000000 @ROOT0_IMG_LEN@ 2> /run/mf2.err; RC=$?
while read -r l; do echo "NEST-DBG mtdflash2: $l" > /dev/kmsg; done < /run/mf2.err
if [ $RC -ne 0 ]; then
    puts error 0 ROOT0 "" "E1 STAGING"
    echo "NEST-INSTALL: staging read/write failed (rootfs alt missing?)" > /dev/kmsg 2>/dev/null
    wdtreset
fi

# 3. verify: the kernel must be able to mount its own jffs2
puts verify 92 ROOT0 "" ""
nest-mtdflash /dev/mtd6ro "$STATE" --verify-mem 0x82000000 @ROOT0_IMG_LEN@ 2> /run/mf3.err; RC=$?
while read -r l; do echo "NEST-DBG mtdflash3: $l" > /dev/kmsg; done < /run/mf3.err
if [ $RC -eq 0 ]; then
    echo "NEST-INSTALL: root0 verified byte for byte against the staging image" > /dev/kmsg 2>/dev/null
    puts done 100 ROOT0 "DONE" ""
    sleep 2
else
    puts error 0 ROOT0 "" "E3 VERIFY"
    echo "NEST-INSTALL: root0 verify FAILED" > /dev/kmsg 2>/dev/null
fi

wdtreset
